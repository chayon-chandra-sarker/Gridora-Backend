model Area {
  id        String                 @id @default(uuid())
  name      String
  city      String
  district  String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  schedules LoadSheddingSchedule[]
  users     User[]

  @@index([name])
  @@index([city])
  @@index([district])
  @@map("areas")
}

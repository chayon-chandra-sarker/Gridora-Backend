model Complaint {
  id          String          @id @default(uuid())

  userId      String
  user        User            @relation(fields: [userId], references: [id])

  title       String
  description String
  status      ComplaintStatus @default(PENDING)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}
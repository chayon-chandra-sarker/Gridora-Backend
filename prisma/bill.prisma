model Bill {
  id              String     @id @default(uuid())
  userId          String
  billingMonth    String
  meterNumber     String
  previousReading Int
  currentReading  Int
  units           Int
  amount          Decimal    @db.Decimal(10, 2)
  dueDate         DateTime
  status          BillStatus @default(UNPAID)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@unique([userId, billingMonth])
  @@index([userId])
  @@index([meterNumber])
  @@index([status])
  @@index([dueDate])
  @@index([billingMonth])
  @@map("bills")
}

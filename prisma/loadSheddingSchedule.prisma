model LoadSheddingSchedule {
  id String @id @default(uuid())

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime

  reason      String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([startTime])
  @@index([endTime])
  @@map("loadSheddingSchedules")
}
